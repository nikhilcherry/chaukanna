LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=chaukanna
VICTIM_IDENTITY=victim          # the victim app joins as this identity (or victim-<anything>)
VICTIM_ID=demo-victim-1         # victim_id sent to n8n

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3      # or saaras:v4
SARVAM_STT_MODE=codemix         # codemix keeps English words (CBI, OTP) in Latin script; or transcribe

CLASSIFIER_URL=http://localhost:8010/classify      # 8000 on this laptop is an unrelated container
N8N_WEBHOOK_URL=https://n8n.premortem.tech/webhook/chaukanna-verdict
N8N_PRESSURE_THRESHOLD=2        # incident fires the first time pressure reaches this
N8N_INCIDENT_TIMEOUT_SECONDS=45 # how long to wait for n8n's incident reply (forwarded to the victim)
REPORT_SCAMMERS=1               # add each incident's caller to the classifier's scam list (redial = flagged)

WHISPER_COOLDOWN_SECONDS=20     # a clip repeats only if pressure rose and this long has passed
CALL_END_GRACE_SECONDS=6        # a participant who drops (not hangs up) can rejoin within this
HEARTBEAT_SECONDS=5
STT_ENGINE=auto                 # auto = Sarvam, local faster-whisper on the GPU when Sarvam fails
WHISPER_MODEL=small             # cached in ~/.cache/huggingface; loads cache-first (works offline)
SILENCE_RMS=120                 # chunks quieter than this are not sent to STT
KNOWN_SCAM_PREFIXES=+92,+855,+95
KNOWN_SCAM_NUMBERS=             # comma-separated, flagged in call_started (the classifier's list is loaded too)
CHUNK_MIN_SECONDS=1.5           # cut at the first pause once this much audio is buffered
CHUNK_MAX_SECONDS=4             # never longer than this (cut at the quietest moment)
PAUSE_MS=300                    # this much quiet ends a chunk

TOKEN_SERVER_PORT=8787          # token_server.py: scammer dialer + caller tokens
VICTIM_TOKEN_KEY=               # set to enable GET /victim-token?key=... for the app's LIVEKIT_TOKEN_URL
VICTIM_TOKEN_TTL=12h

# Guardian console (http://localhost:8787/console/)
# CALL_LOG_DIR=calls            # where the bridge logs calls for the console (default ./calls; set it empty to turn logging off)
CONSOLE_KEY=                    # optional: lets ?key=... read the call API from another machine
CONSOLE_FEED_KEY=               # header key for the n8n "Console network feed" workflow (CONTRACTS §7)
