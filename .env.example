LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=chaukanna
VICTIM_IDENTITY=victim          # the victim app joins as this identity (or victim-<anything>)
VICTIM_ID=demo-victim-1         # victim_id sent to n8n

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3      # or saaras:v4
SARVAM_STT_MODE=transcribe      # transcribe | codemix | translate | verbatim | translit

CLASSIFIER_URL=http://localhost:8010/classify      # 8000 on this laptop is an unrelated container
N8N_WEBHOOK_URL=https://n8n.premortem.tech/webhook/chaukanna-verdict
N8N_PRESSURE_THRESHOLD=2        # incident fires the first time pressure reaches this
N8N_INCIDENT_TIMEOUT_SECONDS=45 # how long to wait for n8n's incident reply (forwarded to the victim)

WHISPER_COOLDOWN_SECONDS=20     # a clip repeats only if pressure rose and this long has passed
CALL_END_GRACE_SECONDS=6        # a participant who drops (not hangs up) can rejoin within this
HEARTBEAT_SECONDS=5
SILENCE_RMS=120                 # chunks quieter than this are not sent to STT
KNOWN_SCAM_PREFIXES=+92,+855,+95
KNOWN_SCAM_NUMBERS=             # comma-separated, flagged in call_started
