    {
      "id": "f74d6cda-f13e-44c3-8091-b84ff24f6921",
      "name": "Build feed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// One response for the guardian console: who called whom, which numbers are listed, who gets alerts.\n// Transcripts, complaint text and Telegram chat ids never leave n8n.\nconst rows = name => $(name).all().map(i => i.json).filter(j => j && Object.keys(j).length && !j.error);\nconst incidents = rows('Incidents').map(r => ({\n  id: r.id, call_id: r.call_id, victim_id: r.victim_id, caller_number: r.caller_number, scam_type: r.scam_type,\n  max_pressure: r.max_pressure, complaint_status: r.complaint_status, family_response: r.family_response,\n  known_scammer: r.known_scammer, asks_otp_or_pin: r.asks_otp_or_pin, demands_secrecy: r.demands_secrecy,\n  last_event: r.last_event, has_draft: !!r.complaint_draft_text, created_at: r.created_at, updated_at: r.updated_at,\n  submitted_at: r.submitted_at,\n})).sort((a, b) => String(b.created_at).localeCompare(String(a.created_at))).slice(0, 300);\nconst scam_numbers = rows('Scam numbers').map(r => ({\n  phone_number: r.phone_number, scam_type: r.scam_type, report_count: r.report_count, risk_level: r.risk_level,\n  first_seen: r.first_seen, last_seen: r.last_seen, last_call_id: r.last_call_id,\n}));\nconst trusted_contacts = rows('Trusted contacts').map(r => ({\n  victim_id: r.victim_id, victim_name: r.victim_name, contact_name: r.contact_name, phone_number: r.phone_number,\n  preferred_language: r.preferred_language, telegram_ready: /^-?\\d{5,}$/.test(String(r.telegram_chat_id || '')),\n}));\nreturn [{ json: { ok: true, at: new Date().toISOString(), incidents, scam_numbers, trusted_contacts } }];\n"
      }
    },
