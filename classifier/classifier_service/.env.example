CLASSIFIER_BACKEND=auto        # auto (jev if TYPESAFE_API_KEY, else gemini, else none) | jev | jev_only | gemini | sarvam | local_laya | mock | none
TYPESAFE_API_KEY=              # Jev (TypeSafe System One): the eval winner, ~0.5 s per call
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=1.5              # slower than this -> Gemini answers instead (jev backend)
GEMINI_API_KEY=                # fallback for jev, or the backend on its own
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m
LAYA_URL=http://127.0.0.1:8001/v1/chat/completions
LAYA_MODEL=laya

# Service (defaults shown)
PORT=8010                      # 8000 is taken on the dev laptop by an unrelated container
CLASSIFY_BUDGET_MS=450         # response budget (spec < 500). A model expected to land inside it is waited for; never on a chunk with a keyword alarm
LLM_TIMEOUT_S=4.0              # hard cap per background LLM run
CALL_TTL_S=900                 # forget a call after 15 min without chunks
MAX_CALLS=500
DELIVERY_OTP_POLICY=caution    # caution: rider asking for the parcel OTP = pressure 1, no whisper | warn: treat as OTP scam
LLM_ON_VICTIM_CHUNKS=0         # 1 = victim chunks also start an LLM run (2x the calls)
WHISPER_GAP_CHUNKS=2           # min chunks between two whispers of equal/lower priority
WARMUP=1                       # one backend call at startup to open the connection
