# Copy to demo/stage/phones.env (gitignored: these are the team's real phone numbers) for
# `demo/stage.sh phone-*`, the real-phone-call stage demo (chaukanna_app PR #1 phone layer).

VICTIM_SIM=+91XXXXXXXXXX        # Kamala's phone (the Nothing phone with the app): the number everyone dials
SCAMMER_SIM=+91XXXXXXXXXX       # the scammer phone's own SIM number (the dialer on Kamala's phone shows it)
SCAMMER_SERIAL=bc9ce721         # `adb devices` serial of the scammer phone (OPPO); empty = dial by hand
SON_SIM=                        # a teammate's phone playing Ravi (son); phone-setup puts it on the trusted list
SON_SERIAL=                     # its adb serial if it is on USB too; empty = dial by hand
DELIVERY_SIM=                   # optional third phone for the delivery call; empty = skip that call
DELIVERY_SERIAL=
